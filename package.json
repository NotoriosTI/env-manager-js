{
  "name": "@notoriosti/env-manager",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.3.0",
  "description": "",
  "type": "module",
  "bin": {
    "env-manager": "./dist/main.js",
    "env-manager-encrypt": "./dist/legacy-encrypt.js",
    "env-manager-decrypt": "./dist/legacy-decrypt.js"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [],
  "author": "bastianibanez",
  "repository": {
    "type": "git",
    "url": "https://github.com/NotoriosTI/env-manager-js"
  },
  "homepage": "https://github.com/NotoriosTI/env-manager-js#readme",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/secret-manager": "^6.1.1",
    "dotenv": "^17.3.1",
    "eciesjs": "^0.4.18",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/node": "^25.5.0",
    "publint": "^0.3.18",
    "tsup": "^8.5.1",
    "typescript": "5.8",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "rimraf": "^6.1.3",
    "node-domexception": "2.0.2"
  }
}
